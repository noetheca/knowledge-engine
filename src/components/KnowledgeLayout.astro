---
import "../styles/base.css";
import { getUiStrings } from "../i18n/ui";
import type { KnowledgeLanguageOption } from "../types";

interface Props {
  title: string;
  summary?: string;
  locale?: string;
  canonicalPath?: string;
  immersive?: boolean;
  domain?: string;
  languages?: readonly KnowledgeLanguageOption[];
}

const {
  title,
  summary = "noetheca knowledge page",
  locale = "ja",
  canonicalPath,
  immersive = false,
  domain = "knowledge base",
  languages,
} = Astro.props;
const defaultLanguageIds: Record<string, string> = {
  ja: "JP",
  en: "EN",
};
const defaultLanguageLabels: Record<string, string> = {
  ja: "日本語",
  en: "English",
};
const languageOptions = languages?.length
  ? languages
  : [{
      id: defaultLanguageIds[locale] ?? locale.slice(0, 2).toUpperCase(),
      label: defaultLanguageLabels[locale] ?? locale,
      locale,
    }];
const currentLanguage =
  languageOptions.find((language) => language.locale === locale) ??
  languageOptions[0];
const ui = getUiStrings(locale);
const domainHomeUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={summary} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@700&display=swap"
    />
    {canonicalPath && <link rel="canonical" href={canonicalPath} />}
    <title>{title} | noetheca</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("noetheca-theme");
          document.documentElement.dataset.theme =
            saved === "light" || saved === "dark" ? saved : "light";
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
  </head>
  <body class:list={{ "immersive-layout": immersive }}>
    <a class="skip-link" href="#main">{ui.layout.skipLink}</a>
    <header class="site-header">
      <div class="site-identity">
        <a class="brand" href="https://noetheca.github.io/">noetheca</a>
        <a class="site-context" href={domainHomeUrl}>{domain}</a>
      </div>
      <div class="site-actions">
        <details class="language-menu" data-language-menu>
          <summary
            class="language-toggle"
            aria-label={ui.layout.changeLanguage}
            title={ui.layout.changeLanguage}
          >
            {currentLanguage?.id ?? locale.slice(0, 2).toUpperCase()}
          </summary>
          <div class="language-menu__list" aria-label={ui.layout.languageMenu}>
            {
              languageOptions.map((language) => {
                const current = language.locale === locale;
                const classNames = {
                  "language-menu__item": true,
                  "is-current": current,
                  "is-unavailable": !current && !language.href,
                };
                const content = (
                  <>
                    <span>{language.label}</span>
                    <small>{language.id}</small>
                  </>
                );
                return current ? (
                  <span class:list={classNames} aria-current="page">
                    {content}
                  </span>
                ) : language.href ? (
                  <a class:list={classNames} href={language.href} hreflang={language.locale}>
                    {content}
                  </a>
                ) : (
                  <span
                    class:list={classNames}
                    aria-disabled="true"
                    title={ui.layout.translationPending}
                  >
                    {content}
                  </span>
                );
              })
            }
          </div>
        </details>
        <button
          class="theme-toggle"
          type="button"
          data-theme-toggle
          data-switch-light-label={ui.layout.switchToLightTheme}
          data-switch-dark-label={ui.layout.switchToDarkTheme}
          data-light-theme-label={ui.layout.lightTheme}
          data-dark-theme-label={ui.layout.darkTheme}
          aria-pressed="false"
        >
          <svg
            class="theme-toggle__icon theme-toggle__icon--light"
            viewBox="0 -960 960 960"
            aria-hidden="true"
          >
            <path d="M480-360q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35Zm0 80q-83 0-141.5-58.5T280-480q0-83 58.5-141.5T480-680q83 0 141.5 58.5T680-480q0 83-58.5 141.5T480-280ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-650l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-98-550 97-101 59 57-100 96-56-52ZM154-212l101-97 55 53-97 101-59-57Zm326-268Z"></path>
          </svg>
          <svg
            class="theme-toggle__icon theme-toggle__icon--dark"
            viewBox="0 -960 960 960"
            aria-hidden="true"
          >
            <path d="M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120Zm0-80q88 0 158-48.5T740-375q-20 5-40 8t-40 3q-123 0-209.5-86.5T364-660q0-20 3-40t8-40q-78 32-126.5 102T200-480q0 116 82 198t198 82Zm-10-270Z"></path>
          </svg>
          <span class="visually-hidden" data-theme-label>
            {ui.layout.lightTheme}
          </span>
        </button>
      </div>
    </header>
    <main id="main" class="page-shell">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{ui.layout.draftNotice}</p>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(
        "[data-theme-toggle]",
      );
      const languageMenu = document.querySelector<HTMLDetailsElement>(
        "[data-language-menu]",
      );

      const applyThemeLabel = () => {
        if (!toggle) return;
        const dark = document.documentElement.dataset.theme === "dark";
        const switchToLight =
          toggle.dataset.switchLightLabel ?? "Switch to light theme";
        const switchToDark =
          toggle.dataset.switchDarkLabel ?? "Switch to dark theme";
        const lightTheme =
          toggle.dataset.lightThemeLabel ?? "Light theme";
        const darkTheme =
          toggle.dataset.darkThemeLabel ?? "Dark theme";
        toggle.setAttribute("aria-pressed", String(dark));
        toggle.setAttribute(
          "aria-label",
          dark ? switchToLight : switchToDark,
        );
        toggle.setAttribute(
          "title",
          dark ? switchToLight : switchToDark,
        );
        const label = toggle.querySelector<HTMLElement>("[data-theme-label]");
        if (label) {
          label.textContent = dark ? darkTheme : lightTheme;
        }
      };

      toggle?.addEventListener("click", () => {
        const next =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        const updateTheme = () => {
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem("noetheca-theme", next);
          } catch {
            // Theme selection still applies for the current page.
          }
          applyThemeLabel();
        };
        const transitionDocument = document as Document & {
          startViewTransition?: (update: () => void) => unknown;
        };
        if (
          transitionDocument.startViewTransition &&
          !window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          transitionDocument.startViewTransition(updateTheme);
        } else {
          updateTheme();
        }
      });

      document.addEventListener("click", (event) => {
        if (
          languageMenu?.open &&
          event.target instanceof Node &&
          !languageMenu.contains(event.target)
        ) {
          languageMenu.open = false;
        }
      });

      languageMenu?.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          languageMenu.open = false;
          languageMenu.querySelector<HTMLElement>("summary")?.focus();
        }
      });

      applyThemeLabel();
    </script>
  </body>
</html>
