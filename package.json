{
  "name": "@noetheca/knowledge-engine",
  "version": "0.0.0",
  "license": "MPL-2.0",
  "description": "Shared validation, manifest, and Astro primitives for noetheca.",
  "type": "module",
  "bin": {
    "noetheca-knowledge": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/KnowledgeLayout.astro": "./src/components/KnowledgeLayout.astro",
    "./components/ConceptRelations.astro": "./src/components/ConceptRelations.astro",
    "./components/KnowledgeGraph.astro": "./src/components/KnowledgeGraph.astro",
    "./components/ArticleDirectives.astro": "./src/components/ArticleDirectives.astro",
    "./styles/base.css": "./src/styles/base.css",
    "./styles/article-directives.css": "./src/styles/article-directives.css"
  },
  "files": [
    "dist",
    "src/client",
    "src/components",
    "src/graph",
    "src/i18n",
    "src/interactives",
    "src/markdown",
    "src/styles",
    "src/types.ts",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test",
    "check": "pnpm typecheck && pnpm test"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.5",
    "katex": "0.18.1",
    "satteri": "0.9.5",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "astro": ">=7.1.0 <8"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "astro": "7.2.1",
    "typescript": "7.0.2"
  }
}
